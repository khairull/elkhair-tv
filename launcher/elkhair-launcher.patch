+import java.util.Locale;
+
+/** Baris cuaca di atas tanggal: ikon + kondisi + suhu °C, gaya sama dengan tulisan tanggal. Data dari Jadwal Sholat. */
+final class WeatherLine {
+    private static final Uri URI = Uri.parse("content://id.elkhair.sholat.weather");
+    private final Activity a;
+    private final Handler main = new Handler(Looper.getMainLooper());
+    private final LinearLayout row;
+    private final Icon icon;
+    private final TextView text;
+
+    private final Runnable tick = new Runnable() {
+        @Override public void run() { load(); main.postDelayed(this, 5 * 60_000L); }
+    };
+
+    WeatherLine(Activity act) {
+        a = act;
+        TextView date = a.findViewById(R.id.date);
+        ViewGroup col = (ViewGroup) date.getParent();
+        row = new LinearLayout(a);
+        row.setOrientation(LinearLayout.HORIZONTAL);
+        row.setGravity(Gravity.CENTER_VERTICAL);
+        icon = new Icon(a);
+        float px = date.getTextSize();
+        LinearLayout.LayoutParams il = new LinearLayout.LayoutParams((int) (px * 1.35f), (int) (px * 1.35f));
+        il.rightMargin = (int) (px * 0.45f);
+        row.addView(icon, il);
+        text = new TextView(a);
+        text.setTextSize(TypedValue.COMPLEX_UNIT_PX, date.getTextSize());
+        text.setTextColor(date.getCurrentTextColor());
+        text.setTypeface(date.getTypeface());
+        text.setLetterSpacing(date.getLetterSpacing());
+        text.setAllCaps(true);
+        text.setSingleLine(true);
+        text.setIncludeFontPadding(false);
+        row.addView(text);
+        icon.color = date.getCurrentTextColor();
+        LinearLayout.LayoutParams rl = new LinearLayout.LayoutParams(-2, -2);
+        rl.bottomMargin = (int) (px * 0.45f);
+        col.addView(row, 0, rl);
+        row.setVisibility(View.GONE);
+    }
+
+    void start() { main.removeCallbacks(tick); main.post(tick); }
+    void stop() { main.removeCallbacks(tick); }
+
+    private void load() {
+        new Thread(() -> {
+            int temp = 0, kind = -1;
+            boolean night = false;
+            String label = null;
+            try (Cursor c = a.getContentResolver().query(URI, null, null, null, null)) {
+                if (c != null && c.moveToFirst()) {
+                    temp = c.getInt(0); kind = c.getInt(1); label = c.getString(2); night = c.getInt(3) == 1;
+                }
+            } catch (Exception ignored) {}
+            final int t = temp, k = kind;
+            final boolean n = night;
+            final String l = label;
+            main.post(() -> {
+                if (k < 0 || l == null) { row.setVisibility(View.GONE); return; }
+                icon.kind = k;
+                icon.night = n;
+                icon.invalidate();
+                text.setText(String.format(Locale.ROOT, "%s  %d°C", l, t));
+                row.setVisibility(View.VISIBLE);
+            });
+        }).start();
+    }
+
+    /** Ikon cuaca garis tipis, warna sama dengan teks tanggal. Jenis: 0 cerah,1 cerah berawan,2 berawan,3 kabut,4 gerimis,5 hujan,6 petir. */
+    static final class Icon extends View {
+        int kind, color = 0xFFFFFFFF;
+        boolean night;
+        private final Paint p = new Paint(Paint.ANTI_ALIAS_FLAG);
+
+        Icon(Context c) { super(c); }
+
+        @Override
+        protected void onDraw(Canvas c) {
+            float s = Math.min(getWidth(), getHeight());
+            p.setColor(color);
+            p.setStyle(Paint.Style.STROKE);
+            p.setStrokeWidth(s * 0.085f);
+            p.setStrokeCap(Paint.Cap.ROUND);
+            p.setStrokeJoin(Paint.Join.ROUND);
+            boolean cloud = kind >= 1;
+            if (kind <= 1) {   // matahari / bulan
+                float cx = kind == 1 ? s * 0.36f : s * 0.5f, cy = kind == 1 ? s * 0.36f : s * 0.5f, r = kind == 1 ? s * 0.16f : s * 0.2f;
+                if (night) {
+                    Path m = new Path();
+                    m.addCircle(cx, cy, r * 1.35f, Path.Direction.CW);
+                    Path cut = new Path();
+                    cut.addCircle(cx + r * 0.75f, cy - r * 0.45f, r * 1.2f, Path.Direction.CW);
+                    m.op(cut, Path.Op.DIFFERENCE);
+                    c.drawPath(m, p);
+                } else {
+                    c.drawCircle(cx, cy, r, p);
+                    for (int i = 0; i < 8; i++) {
+                        double ang = i * Math.PI / 4;
+                        float r1 = r * 1.55f, r2 = r * 2.05f;
+                        if (kind == 1 && (i == 0 || i == 1 || i == 2)) continue;   // tertutup awan
+                        c.drawLine(cx + (float) Math.cos(ang) * r1, cy + (float) Math.sin(ang) * r1,
+                                cx + (float) Math.cos(ang) * r2, cy + (float) Math.sin(ang) * r2, p);
+                    }
+                }
+            }
+            if (cloud) {
+                float top = kind == 1 ? s * 0.42f : kind >= 4 ? s * 0.18f : s * 0.28f;
+                Path cl = new Path();
+                float l = kind == 1 ? s * 0.28f : s * 0.1f, r = s * 0.92f, b = top + s * 0.38f;
+                cl.moveTo(l + s * 0.12f, b);
+                cl.lineTo(r - s * 0.12f, b);
+                cl.arcTo(new RectF(r - s * 0.26f, b - s * 0.26f, r, b), 90, -180);
+                cl.arcTo(new RectF(l + s * 0.22f, top, r - s * 0.08f, top + s * 0.4f), -20, -150);
+                cl.arcTo(new RectF(l, b - s * 0.26f, l + s * 0.26f, b), 270, -180);
+                cl.close();
+                if (kind == 1 && !night) {   // tutup bagian matahari di belakang awan
+                    p.setStyle(Paint.Style.FILL);
+                    p.setColor(0x00000000);
+                }
+                p.setStyle(Paint.Style.STROKE);
+                p.setColor(color);
+                c.drawPath(cl, p);
+                float y0 = b + s * 0.1f;
+                if (kind == 3) for (int i = 0; i < 2; i++) c.drawLine(s * 0.15f, y0 + i * s * 0.14f, s * 0.85f, y0 + i * s * 0.14f, p);
+                if (kind == 4 || kind == 5) {
+                    int n = kind == 4 ? 2 : 3;
+                    for (int i = 0; i < n; i++) {
+                        float x = s * (0.3f + 0.2f * i + (n == 2 ? 0.1f : 0));
+                        c.drawLine(x, y0, x - s * 0.06f, y0 + s * (kind == 4 ? 0.1f : 0.18f), p);
+                    }
+                }
+                if (kind == 6) {
+                    Path bolt = new Path();
+                    bolt.moveTo(s * 0.56f, y0 - s * 0.04f);
+                    bolt.lineTo(s * 0.44f, y0 + s * 0.14f);
+                    bolt.lineTo(s * 0.56f, y0 + s * 0.14f);
+                    bolt.lineTo(s * 0.46f, y0 + s * 0.32f);
+                    c.drawPath(bolt, p);
+                }
+            }
+        }
+    }
+}

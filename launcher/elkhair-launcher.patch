@@ -0,0 +1,234 @@
+package com.gathin.tvhome;
+
+import android.app.Activity;
+import android.content.ComponentName;
+import android.content.pm.PackageManager;
+import android.content.res.ColorStateList;
+import android.graphics.drawable.GradientDrawable;
+import android.graphics.drawable.StateListDrawable;
+import android.media.MediaMetadata;
+import android.media.session.MediaController;
+import android.media.session.MediaSessionManager;
+import android.media.session.PlaybackState;
+import android.os.Handler;
+import android.os.Looper;
+import android.util.TypedValue;
+import android.view.Gravity;
+import android.view.View;
+import android.view.ViewGroup;
+import android.widget.ImageView;
+import android.widget.LinearLayout;
+import android.widget.RelativeLayout;
+import android.widget.TextView;
+
+import java.util.List;
+
+/** Kontrol media di bawah jam: judul yang sedang diputar + sebelumnya / putar-jeda / berikutnya. Hilang bila tidak ada media. */
+final class MediaBar implements MediaSessionManager.OnActiveSessionsChangedListener {
+    private final Activity a;
+    private final Handler main = new Handler(Looper.getMainLooper());
+    private final MediaSessionManager msm;
+    private final ComponentName listener;
+    private final LinearLayout bar;
+    private final TextView title, source;
+    private final ImageView play;
+    private MediaController ctrl;
+
+    private final MediaController.Callback cb = new MediaController.Callback() {
+        @Override public void onPlaybackStateChanged(PlaybackState s) { render(); }
+        @Override public void onMetadataChanged(MediaMetadata m) { render(); }
+        @Override public void onSessionDestroyed() { pick(null); }
+    };
+
+    MediaBar(Activity act) {
+        a = act;
+        float d = a.getResources().getDisplayMetrics().density;
+        msm = a.getSystemService(MediaSessionManager.class);
+        listener = new ComponentName(a, MediaListener.class);
+        bar = new LinearLayout(a);
+        bar.setOrientation(LinearLayout.HORIZONTAL);
+        bar.setGravity(Gravity.CENTER_VERTICAL);
+        bar.setPadding((int) (6 * d), (int) (4 * d), (int) (14 * d), (int) (4 * d));
+        GradientDrawable bg = new GradientDrawable();
+        bg.setCornerRadius(28 * d);
+        bg.setColor(0x66000000);
+        bg.setStroke((int) d, 0x33FFFFFF);
+        bar.setBackground(bg);
+        bar.addView(button(android.R.drawable.ic_media_previous, v -> { if (ctrl != null) ctrl.getTransportControls().skipToPrevious(); }, d));
+        play = button(android.R.drawable.ic_media_pause, v -> toggle(), d);
+        bar.addView(play);
+        bar.addView(button(android.R.drawable.ic_media_next, v -> { if (ctrl != null) ctrl.getTransportControls().skipToNext(); }, d));
+        LinearLayout texts = new LinearLayout(a);
+        texts.setOrientation(LinearLayout.VERTICAL);
+                title = text(14, 0xFFFFFFFF);
+        source = text(11, 0x99FFFFFF);
+        texts.addView(title);
+        texts.addView(source);
+        // Judul bisa dipilih: OK membuka aplikasi pemutarnya (mis. SmartTube) di layar videonya.
+        texts.setFocusable(true);
+        texts.setPadding((int) (12 * d), (int) (4 * d), (int) (12 * d), (int) (4 * d));
+        GradientDrawable tn = new GradientDrawable();
+        tn.setCornerRadius(16 * d);
+        tn.setColor(0x00000000);
+        GradientDrawable tf = new GradientDrawable();
+        tf.setCornerRadius(16 * d);
+        tf.setColor(0x33FFFFFF);
+        tf.setStroke((int) (1.5f * d), 0xFFFFFFFF);
+        StateListDrawable ts = new StateListDrawable();
+        ts.addState(new int[] {android.R.attr.state_focused}, tf);
+        ts.addState(new int[] {}, tn);
+        texts.setBackground(ts);
+        texts.setOnClickListener(v -> openPlayer());
+        bar.addView(texts, new LinearLayout.LayoutParams((int) (300 * d), -2));
+        bar.setVisibility(View.GONE);
+
+        View stats = a.findViewById(R.id.stats);
+        ViewGroup parent = (ViewGroup) stats.getParent();
+        RelativeLayout.LayoutParams lp = new RelativeLayout.LayoutParams(-2, -2);
+        lp.addRule(RelativeLayout.BELOW, R.id.stats);
+        lp.addRule(RelativeLayout.ALIGN_START, R.id.leftBlock);
+        lp.topMargin = (int) (10 * d);
+        parent.addView(bar, lp);
+    }
+
+    void start() {
+        try {
+            msm.addOnActiveSessionsChangedListener(this, listener, main);
+            onActiveSessionsChanged(msm.getActiveSessions(listener));
+        } catch (SecurityException e) {
+            bar.setVisibility(View.GONE);   // izin notification listener belum diberikan
+        }
+    }
+
+    void stop() {
+        main.removeCallbacks(recheck);
+        try { msm.removeOnActiveSessionsChangedListener(this); } catch (Exception ignored) {}
+        if (ctrl != null) ctrl.unregisterCallback(cb);
+    }
+
+    /** Jeda lebih lama dari ini dianggap "tidak ada yang diputar" (aplikasi sudah ditinggalkan). */
+    private static final long PAUSE_TTL = 3 * 60_000L;
+    private List<MediaController> lastList;
+    private final Runnable recheck = () -> onActiveSessionsChanged(lastList);
+
+    private static boolean live(PlaybackState s) {
+        if (s == null) return false;
+        int st = s.getState();
+        if (st == PlaybackState.STATE_PLAYING || st == PlaybackState.STATE_BUFFERING) return true;
+        if (st != PlaybackState.STATE_PAUSED) return false;
+        long upd = s.getLastPositionUpdateTime();
+        return upd <= 0 || android.os.SystemClock.elapsedRealtime() - upd < PAUSE_TTL;
+    }
+
+    @Override
+    public void onActiveSessionsChanged(List<MediaController> list) {
+        lastList = list;
+        MediaController best = null;
+        if (list != null) for (MediaController c : list) {
+            PlaybackState s = c.getPlaybackState();
+            if (!live(s)) continue;
+            if (s.getState() == PlaybackState.STATE_PLAYING) { best = c; break; }
+            if (best == null) best = c;
+        }
+        pick(best);
+    }
+
+    private void pick(MediaController c) {
+        if (ctrl != null) ctrl.unregisterCallback(cb);
+        ctrl = c;
+        if (ctrl != null) ctrl.registerCallback(cb, main);
+        render();
+    }
+
+    private void render() {
+        PlaybackState s = ctrl == null ? null : ctrl.getPlaybackState();
+        int st = s == null ? PlaybackState.STATE_NONE : s.getState();
+        boolean show = live(s);
+        main.removeCallbacks(recheck);
+        // Saat dijeda/berhenti, periksa lagi nanti: sesi lain mungkin aktif, atau jeda sudah kedaluwarsa.
+        if (st != PlaybackState.STATE_PLAYING) main.postDelayed(recheck, 30_000L);
+        if (!show) {
+            if (bar.hasFocus()) a.getWindow().getDecorView().findFocus().clearFocus();
+            bar.setVisibility(View.GONE);
+            return;
+        }
+        MediaMetadata m = ctrl.getMetadata();
+        String t = m == null ? null : m.getString(MediaMetadata.METADATA_KEY_DISPLAY_TITLE);
+        if (t == null && m != null) t = m.getString(MediaMetadata.METADATA_KEY_TITLE);
+        String artist = m == null ? null : m.getString(MediaMetadata.METADATA_KEY_ARTIST);
+        title.setText(t == null ? "Sedang diputar" : t);
+        source.setText((st == PlaybackState.STATE_PLAYING ? "▶ " : "❚❚ ") + appLabel(ctrl.getPackageName())
+                + (artist == null || artist.isEmpty() ? "" : " · " + artist));
+        play.setImageResource(st == PlaybackState.STATE_PLAYING ? android.R.drawable.ic_media_pause : android.R.drawable.ic_media_play);
+        bar.setVisibility(View.VISIBLE);
+    }
+
+    private void openPlayer() {
+        if (ctrl == null) return;
+        try {
+            android.app.PendingIntent pi = ctrl.getSessionActivity();
+            if (pi != null) {
+                android.os.Bundle opts = null;
+                if (android.os.Build.VERSION.SDK_INT >= 34) {
+                    // Izinkan aktivitas aplikasi pemutar dibuka dari launcher (aturan Android 14+).
+                    android.app.ActivityOptions o = android.app.ActivityOptions.makeBasic();
+                    o.setPendingIntentBackgroundActivityStartMode(android.app.ActivityOptions.MODE_BACKGROUND_ACTIVITY_START_ALLOWED);
+                    opts = o.toBundle();
+                }
+                pi.send(a, 0, null, null, null, null, opts);
+                return;
+            }
+        } catch (Exception ignored) {}
+        PackageManager pm = a.getPackageManager();
+        android.content.Intent i = pm.getLeanbackLaunchIntentForPackage(ctrl.getPackageName());
+        if (i == null) i = pm.getLaunchIntentForPackage(ctrl.getPackageName());
+        if (i != null) a.startActivity(i.addFlags(android.content.Intent.FLAG_ACTIVITY_NEW_TASK));
+    }
+
+    private void toggle() {
+        if (ctrl == null) return;
+        PlaybackState s = ctrl.getPlaybackState();
+        if (s != null && s.getState() == PlaybackState.STATE_PLAYING) ctrl.getTransportControls().pause();
+        else ctrl.getTransportControls().play();
+    }
+
+    private String appLabel(String pkg) {
+        try {
+            PackageManager pm = a.getPackageManager();
+            return pm.getApplicationLabel(pm.getApplicationInfo(pkg, 0)).toString();
+        } catch (Exception e) { return pkg; }
+    }
+
+    private ImageView button(int icon, View.OnClickListener l, float d) {
+        ImageView b = new ImageView(a);
+        b.setImageResource(icon);
+        b.setImageTintList(ColorStateList.valueOf(0xFFFFFFFF));
+        b.setScaleType(ImageView.ScaleType.CENTER_INSIDE);
+        b.setPadding((int) (8 * d), (int) (8 * d), (int) (8 * d), (int) (8 * d));
+        b.setFocusable(true);
+        GradientDrawable n = new GradientDrawable();
+        n.setShape(GradientDrawable.OVAL);
+        n.setColor(0x00000000);
+        GradientDrawable f = new GradientDrawable();
+        f.setShape(GradientDrawable.OVAL);
+        f.setColor(0xFFFFFFFF);
+        StateListDrawable sl = new StateListDrawable();
+        sl.addState(new int[] {android.R.attr.state_focused}, f);
+        sl.addState(new int[] {}, n);
+        b.setBackground(sl);
+        b.setOnFocusChangeListener((v, has) -> ((ImageView) v).setImageTintList(ColorStateList.valueOf(has ? 0xFF000000 : 0xFFFFFFFF)));
+        b.setOnClickListener(l);
+        int size = (int) (40 * d);
+        b.setLayoutParams(new LinearLayout.LayoutParams(size, size));
+        return b;
+    }
+
+    private TextView text(float sp, int color) {
+        TextView t = new TextView(a);
+        t.setTextSize(TypedValue.COMPLEX_UNIT_SP, sp);
+        t.setTextColor(color);
+        t.setSingleLine(true);
+        t.setEllipsize(android.text.TextUtils.TruncateAt.END);
+        return t;
+    }
+}
